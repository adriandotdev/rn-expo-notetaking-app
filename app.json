{
	"expo": {
		"name": "Prayers",
		"slug": "prayer",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/prayer-app-icon.png",
		"scheme": "rnpracticev2",
		"userInterfaceStyle": "automatic",
		"ios": {
			"icon": "./assets/expo.icon",
			"bundleIdentifier": "com.prayerhaven.app"
		},
		"android": {
			"package": "com.prayerhaven.app",
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/catholic-app-icon.png",
				"backgroundColor": "#051833",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#208AEF",
					"image": "./assets/images/prayer-app-icon.png",
					"imageWidth": 76
				}
			],
			"expo-font",
			"expo-image",
			"expo-notifications",
			"expo-status-bar",
			"expo-web-browser"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "25f97fa0-dfe8-4c00-9ea1-a64233c6565c"
			}
		},
		"owner": "httpsdotjs"
	}
}
